<?php

/**
 * @file
 * AI Related Content — surface semantically similar nodes using vector search.
 */

/**
 * Implements hook_config_info().
 */
function ai_related_content_config_info() {
  return [
    'ai_related_content.settings' => [
      'label' => t('AI Related Content Settings'),
      'group' => t('AI'),
    ],
  ];
}

/**
 * Implements hook_menu().
 */
function ai_related_content_menu() {
  $items = [];

  $items['admin/config/ai/ai-related-content'] = [
    'title' => 'AI Related Content',
    'description' => 'Configure AI Related Content block settings.',
    'page callback' => 'backdrop_get_form',
    'page arguments' => ['ai_related_content_settings_form'],
    'access arguments' => ['administer site configuration'],
    'type' => MENU_NORMAL_ITEM,
  ];

  $items['admin/config/ai/ai-related-content/test'] = [
    'title' => 'Test Related Content',
    'description' => 'Test the related content functionality.',
    'page callback' => 'backdrop_get_form',
    'page arguments' => ['ai_related_content_test_form'],
    'access arguments' => ['administer site configuration'],
    'type' => MENU_LOCAL_TASK,
  ];

  return $items;
}

/**
 * Settings form.
 */
function ai_related_content_settings_form($form, &$form_state) {
  $form = [];
  $form['#config'] = 'ai_related_content.settings';

  $config = config('ai_related_content.settings');

  // Get all available Search API indexes
  if (!function_exists('search_api_index_load_multiple')) {
    backdrop_set_message(t('Search API module is required but not available.'), 'error');
    return $form;
  }

  // Get all available Search API indexes
  $indexes = search_api_index_load_multiple(FALSE);
  $index_options = [];
  foreach ($indexes as $index_id => $index) {
    if (ai_related_content_index_is_vector_capable($index)) {
      $index_options[$index_id] = $index->name;
    }
  }

  if (empty($index_options)) {
    backdrop_set_message(t('No vector-capable Search API indexes found. Configure a Milvus or Pinecone index with an embedding vector field first.'), 'warning');
  }

  $configured_index_id = $config->get('index_id') ?: '';
  if (!empty($configured_index_id) && !isset($index_options[$configured_index_id])) {
    $configured_index_id = '';
  }

  $form['index_id'] = [
    '#type' => 'select',
    '#title' => t('Search API Index'),
    '#description' => t('Select a vector-capable Search API index (Milvus or Pinecone) that contains your embeddings. The vector search server used comes from the server assigned to this index in Search API.'),
    '#options' => $index_options,
    '#default_value' => $configured_index_id,
    '#required' => TRUE,
    '#ajax' => [
      'callback' => 'ai_related_content_settings_form_ajax',
      'wrapper' => 'backend-specific-settings',
      'method' => 'replace',
    ],
  ];

  // Get the selected index to determine backend type
  $selected_index_id = !empty($form_state['values']['index_id'])
    ? $form_state['values']['index_id']
    : $config->get('index_id');

  $backend_type = NULL;
  if ($selected_index_id && function_exists('search_api_index_load')) {
    $selected_index = search_api_index_load($selected_index_id);
    if ($selected_index && $selected_index->server()) {
      $backend_type = strtolower($selected_index->server()->class);
    }
  }

  $form['backend_settings'] = [
    '#type' => 'fieldset',
    '#title' => t('Backend-Specific Settings'),
    '#prefix' => '<div id="backend-specific-settings">',
    '#suffix' => '</div>',
  ];

  if ($backend_type === 'milvus') {
    $form['backend_settings']['info'] = [
      '#markup' => '<p><em>' . t('Backend detected: <strong>Milvus</strong>') . '</em></p>',
    ];

    $form['backend_settings']['collection_name'] = [
      '#type' => 'textfield',
      '#title' => t('Collection Name'),
      '#description' => t('The name of the Milvus collection to query for related content.'),
      '#default_value' => $config->get('collection_name') ?: '',
      '#required' => TRUE,
    ];
  }
  elseif ($backend_type === 'pinecone') {
    $form['backend_settings']['info'] = [
      '#markup' => '<p><em>' . t('Backend detected: <strong>Pinecone</strong>') . '</em></p>' .
        '<p>' . t('Pinecone uses namespaces which are automatically determined from your server configuration and index machine name. No additional settings needed here.') . '</p>',
    ];

    // Store empty collection_name for Pinecone (not used)
    $form['backend_settings']['collection_name'] = [
      '#type' => 'value',
      '#value' => '',
    ];
  }
  else {
    $form['backend_settings']['info'] = [
      '#markup' => '<p><em>' . t('Please select a Search API index above to see backend-specific settings.') . '</em></p>',
    ];

    $form['backend_settings']['collection_name'] = [
      '#type' => 'value',
      '#value' => $config->get('collection_name') ?: '',
    ];
  }

  $form['limit'] = [
    '#type' => 'number',
    '#title' => t('Number of related items'),
    '#description' => t('How many related content items to display.'),
    '#default_value' => $config->get('limit') ?: 3,
    '#min' => 1,
    '#max' => 10,
    '#required' => TRUE,
  ];

  $form['node_view_mode'] = [
    '#type' => 'select',
    '#title' => t('Node View Mode For Embedding Extraction'),
    '#description' => t('Choose which node view mode should be rendered when extracting text for embeddings. Use <code>full</code> for maximum content, or another mode for more focused extraction.'),
    '#options' => ai_related_content_get_node_view_mode_options(),
    '#default_value' => $config->get('node_view_mode') ?: 'full',
    '#required' => TRUE,
  ];

  // Views integration helper: allow selecting a View display to use/maintain.
  // This does not strictly control output (the recommended display is the
  // Views block powered by the argument default plugin), but it provides a
  // clear reference for admins and an easy navigation link.
  $form['views_integration'] = [
    '#type' => 'fieldset',
    '#title' => t('Views integration'),
    '#collapsible' => TRUE,
    '#collapsed' => FALSE,
  ];

  $view_display_default = $config->get('view_display') ?: '';
  $options = ['' => t('- None selected -')];

  if (function_exists('views_get_all_views')) {
    $all_views = views_get_all_views();
    foreach ($all_views as $view) {
      if (empty($view->display)) continue;
      foreach ($view->display as $display_id => $display) {
        // Offer block displays primarily, but list any display in case site
        // builders want to reference a page display.
        $type = isset($display->display_plugin) ? $display->display_plugin : '';
        $is_block = ($type === 'block');
        $title = !empty($display->display_title) ? $display->display_title : $display_id;
        $prefix = $is_block ? t('Block') : strtoupper($type);
        $label = t('@view (@type): @display', [
          '@view' => $view->human_name ?: $view->name,
          '@type' => $prefix,
          '@display' => $title,
        ]);
        $options[$view->name . ':' . $display_id] = $label;
      }
    }
  }

  $form['views_integration']['view_display'] = [
    '#type' => 'select',
    '#title' => t('Recommended View display'),
    '#description' => t('Select the View display you use to render related content. This is for reference and quick access only. To make it work, edit that View and set the contextual filter "Content: Nid" default value to "AI: Related node IDs".'),
    '#options' => $options,
    '#default_value' => $view_display_default,
  ];

  // Provide a convenience link to edit the selected View display (if any).
  if (!empty($view_display_default) && strpos($view_display_default, ':') !== FALSE) {
    list($sel_view, $sel_display) = explode(':', $view_display_default, 2);
    $edit_path = 'admin/structure/views/view/' . $sel_view . '/configure/' .
      $sel_display;
    $form['views_integration']['view_display_link'] = [
      '#type' => 'item',
      '#title' => t('Edit selected display'),
      '#markup' => l(t('Open the selected View display'), $edit_path, ['attributes' => ['target' => '_blank', 'rel' => 'noopener noreferrer']]),    ];
  }

  // Cache management
  $form['cache_management'] = [
    '#type' => 'fieldset',
    '#title' => t('Cache Management'),
    '#collapsible' => TRUE,
    '#collapsed' => TRUE,
  ];

  $form['cache_management']['info'] = [
    '#markup' => '<p>' . t('Related content blocks are cached for 1 week. If you change the configuration or reindex content, you should clear the related content cache.') . '</p>',
  ];

  $form['cache_management']['clear_cache'] = [
    '#type' => 'submit',
    '#value' => t('Clear Related Content Cache'),
    '#submit' => ['ai_related_content_clear_cache_submit'],
    '#limit_validation_errors' => [],
  ];

  // Exclusion management
  $form['exclusions'] = [
    '#type' => 'fieldset',
    '#title' => t('Exclusions'),
    '#collapsible' => TRUE,
    '#collapsed' => TRUE,
    '#description' => t('Exclude specific nodes from appearing in related content results. Note: You can also configure exclusions through the View filters, or use the "Exclude from related content" checkbox on individual node edit forms.'),
  ];

  $form['exclusions']['excluded_urls'] = [
    '#type' => 'textarea',
    '#title' => t('Excluded URLs'),
    '#description' => t('Enter one URL or path per line. Examples: <code>/about</code>, <code>/contact</code>, <code>node/123</code>. Both absolute paths and node/NID format are supported.'),
    '#default_value' => $config->get('excluded_urls') ?: '',
    '#rows' => 10,
  ];

  $form['exclusions']['info'] = [
    '#markup' => '<div class="messages info"><strong>Exclusion Methods:</strong><ul>' .
      '<li><strong>URL-based (this form):</strong> Enter URLs/paths above - applies globally</li>' .
      '<li><strong>Per-node (node edit form):</strong> Check "Exclude from related content" when editing a node</li>' .
      '<li><strong>View filters (recommended for complex rules):</strong> Edit the view and add filters for content type, taxonomy, etc.</li>' .
      '</ul></div>',
  ];

  return system_settings_form($form);
}

/**
 * AJAX callback for settings form index selection.
 */
function ai_related_content_settings_form_ajax($form, &$form_state) {
  return $form['backend_settings'];
}

/**
 * Submit handler to clear related content cache.
 */
function ai_related_content_clear_cache_submit($form, &$form_state) {
  ai_related_content_invalidate_caches();

  backdrop_set_message(t('Related content cache cleared successfully.'), 'status');
}

/**
 * Get available node view mode options.
 *
 * @return array
 *   Keyed array of view mode machine names => labels.
 */
function ai_related_content_get_node_view_mode_options() {
  $options = [];

  if (function_exists('entity_get_info')) {
    $entity_info = entity_get_info('node');
    if (!empty($entity_info['view modes']) && is_array($entity_info['view modes'])) {
      foreach ($entity_info['view modes'] as $machine_name => $view_mode) {
        $label = !empty($view_mode['label']) ? $view_mode['label'] : $machine_name;
        $options[$machine_name] = $label . ' (' . $machine_name . ')';
      }
    }
  }

  // Fallback and guarantees.
  if (empty($options)) {
    $options = [
      'full' => t('Full') . ' (full)',
      'teaser' => t('Teaser') . ' (teaser)',
      'rss' => t('RSS') . ' (rss)',
    ];
  }
  elseif (!isset($options['full'])) {
    $options = ['full' => t('Full') . ' (full)'] + $options;
  }

  return $options;
}

/**
 * Determine whether a Search API index is suitable for vector related-content lookup.
 *
 * @param SearchApiIndex $index
 *   The Search API index object.
 *
 * @return bool
 *   TRUE when index has a Milvus/Pinecone backend and at least one
 *   llm_vector_embedding field.
 */
function ai_related_content_index_is_vector_capable($index) {
  if (empty($index) || !is_object($index) || !method_exists($index, 'server')) {
    return FALSE;
  }

  $server = $index->server();
  if (empty($server) || empty($server->class)) {
    return FALSE;
  }

  $server_class = strtolower($server->class);
  if (!in_array($server_class, ['milvus', 'pinecone'], TRUE)) {
    return FALSE;
  }

  if (!empty($index->options['fields']) && is_array($index->options['fields'])) {
    foreach ($index->options['fields'] as $field_info) {
      if (!empty($field_info['real_type']) && $field_info['real_type'] === 'llm_vector_embedding') {
        return TRUE;
      }
    }
  }

  return FALSE;
}

/**
 * Implements hook_views_api().
 */
function ai_related_content_views_api() {
  return [
    'api' => 3,
    'path' => backdrop_get_path('module', 'ai_related_content') . '/includes',
  ];
}

/**
 * Implements hook_autoload_info().
 */
function ai_related_content_autoload_info() {
  return [
    'ai_related_content_handler_argument' => 'includes/ai_related_content_handler_argument.inc',
  ];
}


function ai_related_content_block_info() {
  return [
    'ai_related_content_block' => [
      'info' => t('AI Related Content (Legacy Block)'),
      'description' => t('Displays related content using direct rendering. For Views-based display, use the "AI Related Content" view block instead.'),
    ],
  ];
}

/**
 * Implements hook_block_view().
 */
function ai_related_content_block_view($delta = '') {
  if ($delta !== 'ai_related_content_block') {
    return NULL;
  }

  // Only display on canonical node/% pages.
  if (arg(0) !== 'node' || !is_numeric(arg(1)) || !empty(arg(2))) {
    return NULL;
  }

  $node = menu_get_object('node');
  if (!$node || !is_numeric($node->nid)) {
    return NULL;
  }

  $config = config('ai_related_content.settings');
  $view_mode = $config->get('node_view_mode') ?: 'full';
  // Results are filtered by node_access() for the user who primes the cache,
  // so the cache must vary by role — otherwise a privileged user's results
  // (including rendered teasers) would be served to anonymous visitors.
  $cache_key = 'ai_related_content:' . $node->nid . ':' . $view_mode . ':' . ai_related_content_role_cache_suffix();
  $cached = cache_get($cache_key, 'cache');

  if ($cached && isset($cached->data['output'])) {
    $output = $cached->data['output'];
  } else {
    $related = ai_related_content_get_related_matches($node, 3);

    if (empty($related)) {
      $output = t('No related content found.');
    } else {
      $output = '<div class="related-content-grid">';
      foreach ($related as $match) {
        $nid = $match['nid'];
        $related_node = node_load($nid);
        if (!$related_node || !$related_node->status) continue;

        // Get the node view but disable links for teasers
        $view = node_view($related_node, 'teaser');
        // Remove links that should not be shown
        if (isset($view['links'])) {
          unset($view['links']['node']['#links']['node-delete']);
          unset($view['links']['node']['#links']['node-edit']);
        }
        $teaser = !empty($view) ? render($view) : '';
        $output .= '<div class="related-content-item">' . $teaser . '</div>';
      }
      $output .= '</div>';
    }

    // Cache for 1 week (604800 seconds)
    cache_set($cache_key, ['output' => $output], 'cache', REQUEST_TIME + 604800);
  }

  return [
    'subject' => t('Related Content'),
    'content' => [
      '#markup' => $output,
      '#attached' => [
        'css' => [backdrop_get_path('module', 'ai_related_content') . '/ai_related_content.css'],
      ],
    ],
  ];
}

/**
 * Fetch related matches (nid + title) for a given node.
 *
 * @param object $node
 *   The current node object.
 * @param int $limit
 *   Number of related items.
 * @param string $index_id
 *   Optional Search API index ID (for view plugin).
 * @return array
 *   Array of ['nid' => ..., 'title' => ...]
 */
function ai_related_content_get_related_matches($node, $limit = 3, $index_id = NULL) {
  $config = config('ai_related_content.settings');
  if (!$index_id) {
    $index_id = $config->get('index_id') ?: NULL;
  }
  $view_mode = $config->get('node_view_mode') ?: 'full';
  // Vary by role: matches are node_access()-filtered for the priming user.
  $cache_key = 'ai_related_content_matches:' . $node->nid . ':' . $limit . ':' . ($index_id ?: 'default') . ':' . $view_mode . ':' . ai_related_content_role_cache_suffix();
  $cached = cache_get($cache_key, 'cache');

  if ($cached && isset($cached->data)) {
    return $cached->data;
  }

  $text = ai_related_content_get_text($node);
  $embedding = ai_related_content_get_embedding($text, $index_id);
  if (empty($embedding)) return [];
  $matches = ai_related_content_vector_search($embedding, $node->nid, $limit, $index_id);

  // Cache for 1 week (604800 seconds)
  cache_set($cache_key, $matches, 'cache', REQUEST_TIME + 604800);

  return $matches;
}

/**
 * Cache key suffix representing the current user's roles.
 *
 * Related-content results are access-filtered at build time, so cached
 * entries are only valid for users with the same role set.
 */
function ai_related_content_role_cache_suffix() {
  global $user;
  $roles = !empty($user->roles) ? (array) $user->roles : ['anonymous'];
  sort($roles);
  return substr(hash('sha256', implode(',', $roles)), 0, 12);
}

/**
 * Extracts the text from a node for embedding.
 *
 * This function renders the node and extracts all visible text content,
 * making it compatible with nodes that use Paragraphs, Layout Builder,
 * or any field-based content structure - not just the body field.
 *
 * @param object $node
 *   The node object.
 * @return string
 *   The extracted text content.
 */
function ai_related_content_get_text($node) {
  $config = config('ai_related_content.settings');
  $view_mode = $config->get('node_view_mode') ?: 'full';
  return AIContentExtractor::extractEntityText('node', $node, [
    'view_mode' => $view_mode,
    'include_label' => TRUE,
    'max_length' => 8000,
  ]);
}

/**
 * Helper function to extract text from common field types.
 *
 * This is a fallback method when rendering fails or produces no content.
 *
 * @param object $node
 *   The node object.
 * @return array
 *   Array of text strings extracted from fields.
 */
function ai_related_content_extract_field_text($node) {
  $text_parts = [];
  $visited_paragraph_ids = [];
  AIContentExtractor::collectEntityFieldText(
    'node',
    $node,
    $text_parts,
    $visited_paragraph_ids,
    ['keep_numeric' => TRUE]
  );
  return array_values(array_unique(array_filter(array_map('trim', $text_parts))));
}

/**
 * Resolve a configured AI provider API key without assuming legacy config.
 *
 * @param string|null $provider_id
 *   Optional provider ID. Defaults to the active AI default provider.
 *
 * @return string|null
 *   The resolved API key, or NULL when it cannot be determined.
 */
function ai_related_content_resolve_api_key($provider_id = NULL) {
  $provider_id = $provider_id ?: (function_exists('ai_default_provider_id') ? ai_default_provider_id() : '');
  if ($provider_id === '' || !function_exists('ai_get_provider_setting')) {
    return NULL;
  }

  $api_key_reference = ai_get_provider_setting($provider_id, 'api_key', '');
  if ($api_key_reference === '') {
    return NULL;
  }

  if (function_exists('key_get_key') && function_exists('key_get_key_value')) {
    $key_config = key_get_key($api_key_reference);
    if (is_array($key_config) && !empty($key_config['key_provider'])) {
      return key_get_key_value($key_config);
    }
  }

  return is_string($api_key_reference) ? $api_key_reference : NULL;
}

/**
 * Ensure a Search API AI vector client class is available.
 *
 * @param string $backend
 *   Supported backend key: 'milvus' or 'pinecone'.
 *
 * @return bool
 *   TRUE when the class is available, FALSE otherwise.
 */
function ai_related_content_ensure_vector_client($backend) {
  $definitions = [
    'milvus' => [
      'module' => 'ai_search_provider_milvus',
      'file' => 'includes/AiSearchMilvusVectorClient',
      'class' => 'AiSearchMilvusVectorClient',
    ],
    'pinecone' => [
      'module' => 'ai_search_provider_pinecone',
      'file' => 'includes/AiSearchPineconeVectorClient',
      'class' => 'AiSearchPineconeVectorClient',
    ],
  ];

  if (empty($definitions[$backend])) {
    return FALSE;
  }

  $definition = $definitions[$backend];
  if (!class_exists($definition['class']) && module_exists($definition['module'])) {
    @module_load_include('php', $definition['module'], $definition['file']);
  }

  return class_exists($definition['class']);
}

/**
 * Minimal requirements checker used by the test form.
 * Returns an array of requirement items compatible with Backdrop's system.
 *
 * @param string $mode
 *   'runtime' or other modes (unused currently).
 * @return array
 */
function ai_related_content_runtime_requirements($mode = 'runtime') {
  $requirements = [];

  // AI module availability.
  if (module_exists('ai')) {
    $requirements[] = [
      'title' => t('AI module'),
      'severity' => 0,
      'description' => t('AI module is available.'),
    ];
  }
  else {
    $requirements[] = [
      'title' => t('AI module'),
      'severity' => 1,
      'description' => t('AI module is missing. Some features will be disabled.'),
    ];
  }

  // Vector client classes
  $has_milvus = ai_related_content_ensure_vector_client('milvus');
  $has_pinecone = ai_related_content_ensure_vector_client('pinecone');

  if ($has_milvus || $has_pinecone) {
    $backends = [];
    if ($has_milvus) $backends[] = 'Milvus';
    if ($has_pinecone) $backends[] = 'Pinecone';

    $requirements[] = [
      'title' => t('Vector client'),
      'severity' => 0,
      'description' => t('Vector client available: @backends', ['@backends' => implode(', ', $backends)]),
    ];
  }
  else {
    $requirements[] = [
      'title' => t('Vector client'),
      'severity' => 1,
      'description' => t('No vector client class found (AiSearchMilvusVectorClient or AiSearchPineconeVectorClient). Vector searches will be disabled.'),
    ];
  }

  // Search API availability
  if (function_exists('search_api_index_load')) {
    $requirements[] = [
      'title' => t('Search API'),
      'severity' => 0,
      'description' => t('Search API functions are available.'),
    ];
  }
  else {
    $requirements[] = [
      'title' => t('Search API'),
      'severity' => 1,
      'description' => t('Search API module is not available.'),
    ];
  }

  // API key configured?
  $api_key = ai_related_content_resolve_api_key();

  if (!empty($api_key)) {
    $requirements[] = [
      'title' => t('AI API key'),
      'severity' => 0,
      'description' => t('AI API key appears configured.'),
    ];
  }
  else {
    $requirements[] = [
      'title' => t('AI API key'),
      'severity' => 1,
      'description' => t('No AI API key configured. Embeddings and related content will not work.'),
    ];
  }

  return $requirements;
}

/**
 * Gets embedding vector using the index embedding model when available.
 *
 * @param string $text
 *   The text to generate an embedding for.
 * @param string|null $index_id
 *   Optional Search API index machine name. When provided, this function
 *   prefers the index's configured embeddings engine/model.
 * @return array|null
 *   The embedding vector as an array of floats, or NULL on failure.
 */
function ai_related_content_get_embedding($text, $index_id = NULL) {
  $embedding_model = NULL;
  $expected_dimension = NULL;

  // Preferred path: use Search API AI model from the selected index
  if (!empty($index_id) && function_exists('search_api_index_load')) {
    $index = search_api_index_load($index_id);
    if ($index && !empty($index->options['embedding_settings']['embeddings_engine'])) {
      $embedding_model = $index->options['embedding_settings']['embeddings_engine'];
      $expected_dimension = !empty($index->options['embedding_settings']['embeddings_engine_configuration']['dimension'])
        ? (int) $index->options['embedding_settings']['embeddings_engine_configuration']['dimension']
        : NULL;
    }
  }

  // Fallback path: legacy AI module embedding config.
  if (empty($embedding_model)) {
    $embedding_model = config_get('ai.settings', 'embedding_model') ?: 'text-embedding-3-small';
  }

  try {
    $stripped_model = NULL;
    $client = function_exists('ai_get_api_for_model') ? ai_get_api_for_model($embedding_model, $stripped_model) : NULL;
    if ($client) {
      $model_to_use = !empty($stripped_model) ? $stripped_model : $embedding_model;
      // Ensure we don't have a prefix if the client is already provider-specific
      if (strpos($model_to_use, '/') !== FALSE) {
        list(, $model_to_use) = explode('/', $model_to_use, 2);
      }

      $vector = $client->embedding($text, $model_to_use);
      if (is_array($vector) && isset($vector[0]) && is_numeric($vector[0])) {
        if ($expected_dimension && count($vector) !== $expected_dimension) {
          watchdog('ai_related_content', 'Embedding dimension mismatch. Expected @expected, got @actual.', [
            '@expected' => $expected_dimension,
            '@actual' => count($vector),
          ], WATCHDOG_WARNING);
        }
        return $vector;
      }
    }
  }
  catch (\Exception $e) {
    watchdog('ai_related_content', 'Embedding generation failed for model @model: @msg', [
      '@model' => $embedding_model,
      '@msg' => $e->getMessage(),
    ], WATCHDOG_WARNING);
  }

  return NULL;
}

/**
 * Get the default embedding dimension for a given model.
 *
 * Maps embedding model names to their expected vector dimensions.
 * This ensures consistent dimensionality across the module and external vector stores.
 *
 * @param string $model
 *   The embedding model name (e.g., 'text-embedding-3-small', 'text-embedding-3-large').
 *
 * @return int
 *   The default dimension for the model. Returns 1536 as a global fallback.
 */
function ai_related_content_get_default_embedding_dimension($model = NULL) {
  // Model to dimension mapping
  $model_dimensions = [
    'text-embedding-3-small' => 1536,
    'text-embedding-3-large' => 3072,
    'text-embedding-ada-002' => 1536,
    'text-embedding-ada-001' => 1024,
  ];

  // If model is provided and exists in our mapping, use it
  if ($model && isset($model_dimensions[$model])) {
    return $model_dimensions[$model];
  }

  // Global default dimension (text-embedding-3-small standard).
  return 1536;
}

/**
 * Get the Pinecone namespace for a given index.
 *
 * Constructs the namespace for Pinecone operations by combining the server-level
 * namespace (if configured) with the index machine name, or uses just the machine
 * name if no server namespace is set.
 *
 * @param object $index
 *   The Search API index object. If NULL, returns an empty string.
 *
 * @return string
 *   The computed namespace for use with Pinecone queries, or empty string if
 *   the index is invalid.
 */
function ai_related_content_get_pinecone_namespace($index) {
  // Handle invalid index
  if (empty($index) || !is_object($index)) {
    return '';
  }

  // Check if index has a server
  $server = NULL;
  if (method_exists($index, 'server')) {
    $server = $index->server();
  }

  if (empty($server)) {
    return '';
  }

  // Match AIPineconeService::getNamespace(): the server-level namespace wins
  // when set, otherwise the index machine name is used. Vectors were indexed
  // under that namespace, so deriving anything else returns zero matches.
  $namespace = !empty($server->options['namespace'])
    ? trim((string) $server->options['namespace'])
    : $index->machine_name;

  return preg_replace('/[^A-Za-z0-9_\-]/', '_', $namespace);
}

/**
 * Perform Milvus vector search and normalize results.
 *
 * @param object $server
 *   The Search API server object.
 * @param string $collection
 *   The collection name to search.
 * @param array $embedding
 *   The embedding vector.
 * @param int $limit
 *   The number of results to limit to.
 *
 * @return array
 *   Array of matches with 'nid' and 'title' keys, or empty array on failure.
 */
function ai_related_content_milvus_search($server, $collection, $embedding, $limit) {
  // Milvus backend
  if (!ai_related_content_ensure_vector_client('milvus')) {
    watchdog('ai_related_content', 'Milvus vector client class is unavailable. Enable the AI Search Milvus provider module and its dependencies before using a Milvus index.', [], WATCHDOG_WARNING);
    return [];
  }

  try {
    $vector_client = new AiSearchMilvusVectorClient($server->options);
    $database = !empty($server->options['database']) ? $server->options['database'] : 'default';

    // Request common metadata fields that might contain node info.
    // Milvus collections from Search API AI may use different field names.
    $outputFields = ['nid', 'title', 'entity_id', 'entity_type', 'backdrop_entity_id', 'backdrop_long_id'];
    $top_k = max(100, (int)$limit * 50);

    $matches = $vector_client->search($collection, $embedding, $top_k, $outputFields, $database);

    // Keep logging only when no matches are returned to avoid noisy logs.
    if (empty($matches)) {
      watchdog('ai_related_content', 'Milvus search returned no matches for collection @collection (database @database, embedding_dim @dim).', [
        '@collection' => $collection,
        '@database' => $database,
        '@dim' => is_array($embedding) ? count($embedding) : 0,
      ], WATCHDOG_WARNING);
    }

    // Normalize results: extract nid from various possible field structures.
    $normalized = [];
    if (is_array($matches)) {
      foreach ($matches as $match) {
        // Some responses may nest useful fields in metadata.
        if (isset($match['metadata']) && is_array($match['metadata'])) {
          $match = $match + $match['metadata'];
        }

        $nid = NULL;
        $title = '';

        // Try to get nid from various possible fields.
        if (!empty($match['nid'])) {
          $nid = $match['nid'];
        }
        // NOTE: We check entity_type === 'node' before accepting entity_id. However,
        // in some vector store metadata the entity_type field may be missing or may
        // indicate a different entity (for example 'user' or 'taxonomy_term'). If
        // entity_type is present and not 'node', we should *not* treat
        // entity_id as a node id. Use a slightly more permissive check that will
        // accept entity_id when entity_type is absent (common for older indices)
        // or when it explicitly equals 'node'. This avoids accidentally loading
        // the wrong entity type while increasing compatibility with metadata that
        // doesn't include entity_type.
        elseif (!empty($match['entity_id']) && (empty($match['entity_type']) || $match['entity_type'] === 'node')) {
          $nid = $match['entity_id'];
        }
        elseif (!empty($match['backdrop_entity_id']) && preg_match('/^node:(\d+)/', $match['backdrop_entity_id'], $m)) {
          $nid = $m[1];
        }
        elseif (!empty($match['backdrop_entity_id']) && preg_match('/entity:node\/(\d+)/', $match['backdrop_entity_id'], $m)) {
          $nid = $m[1];
        }
        elseif (!empty($match['backdrop_long_id']) && preg_match('/entity:node\/(\d+)/', $match['backdrop_long_id'], $m)) {
          $nid = $m[1];
        }
        elseif (!empty($match['id']) && preg_match('/entity:node\/(\d+)/', $match['id'], $m)) {
          $nid = $m[1];
        }

        // Get title if available.
        if (!empty($match['title'])) {
          $title = $match['title'];
        }

        if ($nid) {
          $normalized[] = [
            'nid' => $nid,
            'title' => $title,
          ];
        }
      }
    }
    return $normalized;
  }
  catch (\Exception $e) {
    watchdog('ai_related_content', 'Milvus vector search failed: @msg', ['@msg' => $e->getMessage()], WATCHDOG_ERROR);
    return [];
  }
}

/**
 * Perform Pinecone vector search and normalize results.
 *
 * @param object $server
 *   The Search API server object.
 * @param object $index
 *   The Search API index object.
 * @param array $embedding
 *   The embedding vector.
 * @param int $limit
 *   The number of results to limit to.
 *
 * @return array
 *   Array of matches with 'nid', 'title', and 'score' keys, or empty array on failure.
 */
function ai_related_content_pinecone_search($server, $index, $embedding, $limit) {
  // Pinecone backend
  if (!ai_related_content_ensure_vector_client('pinecone')) {
    watchdog('ai_related_content', 'Pinecone vector client class is unavailable. Enable the AI Search Pinecone provider module and its dependencies before using a Pinecone index.', [], WATCHDOG_WARNING);
    return [];
  }

  try {
    $vector_client = new AiSearchPineconeVectorClient($server->options);

    // Get namespace using helper function for consistency
    $namespace = ai_related_content_get_pinecone_namespace($index);

    // Get dimension from index configuration or derive from embedding model
    $dimension = NULL;
    if (!empty($index->options['embedding_settings']['embeddings_engine_configuration']['dimension'])) {
      $dimension = (int) $index->options['embedding_settings']['embeddings_engine_configuration']['dimension'];
    } else {
      // Try to get the embedding model and derive the dimension
      $model = NULL;
      if (!empty($index->options['embedding_settings']['model'])) {
        $model = $index->options['embedding_settings']['model'];
      }
      // Use helper to get default dimension for the model
      $dimension = ai_related_content_get_default_embedding_dimension($model);
    }

    $top_k = max(100, (int)$limit * 50);

    $query_params = [
      'vector' => $embedding,
      'top_k' => $top_k,
      'namespace' => $namespace,
      'include_metadata' => TRUE,
      'expected_dimension' => $dimension,
    ];

    $result = $vector_client->query($query_params);

    // Pinecone returns results in 'matches' array
    $matches = [];
    if (!empty($result['matches']) && is_array($result['matches'])) {
      foreach ($result['matches'] as $match) {
        $metadata = $match['metadata'] ?? [];
        $nid = NULL;

        // Try multiple ways to extract the node ID from metadata
        if (!empty($metadata['nid'])) {
          $nid = $metadata['nid'];
        }
        elseif (!empty($metadata['entity_id']) && (!empty($metadata['entity_type']) && $metadata['entity_type'] === 'node')) {
          $nid = $metadata['entity_id'];
        }
        elseif (!empty($metadata['backdrop_entity_id']) && preg_match('/^node:(\d+)/', $metadata['backdrop_entity_id'], $m)) {
          $nid = $m[1];
        }
        elseif (!empty($match['id'])) {
          // Try to extract node ID from the Pinecone vector ID (often formatted as "node:123:field_name")
          if (preg_match('/^node[:\-_]?(\d+)/i', $match['id'], $m)) {
            $nid = $m[1];
          }
          elseif (preg_match('/entity[:\-_]?node[:\-_\/]?(\d+)/i', $match['id'], $m)) {
            $nid = $m[1];
          }
        }

        $title = $metadata['title'] ?? '';

        $matches[] = [
          'nid' => $nid,
          'title' => $title,
          'score' => $match['score'] ?? 0,
        ];
      }
    }

    return $matches;
  }
  catch (\Exception $e) {
    watchdog('ai_related_content', 'Pinecone vector search failed: @msg', ['@msg' => $e->getMessage()], WATCHDOG_ERROR);
    return [];
  }
}

/**
 * Search vector database for similar nodes, returning nid and title.
 * Supports both Milvus and Pinecone backends.
 */
function ai_related_content_vector_search($embedding, $exclude_nid, $limit = 3, $index_id = NULL) {
  // Validate embedding
  if (empty($embedding) || !is_array($embedding)) {
    watchdog('ai_related_content', 'Invalid or empty embedding provided to vector search. Type: @type', [
      '@type' => gettype($embedding),
    ], WATCHDOG_WARNING);
    return [];
  }

  // Get config
  $config = config('ai_related_content.settings');
  if (!$index_id) {
    $index_id = $config->get('index_id') ?: '';
  }
  if ($index_id === '') {
    watchdog('ai_related_content', 'No Search API index configured; cannot perform vector search. Configure one at admin/config/ai/ai-related-content.', [], WATCHDOG_WARNING);
    return [];
  }
  $collection = $config->get('collection_name') ?: '';

  // Load the Search API index and get the server
  if (!function_exists('search_api_index_load')) {
    watchdog('ai_related_content', 'Search API functions not available; cannot perform vector search.', [], WATCHDOG_WARNING);
    return [];
  }

  $index = search_api_index_load($index_id);
  if (!$index || !$index->server()) {
    watchdog('ai_related_content', 'Search API index or server not found for index: @index', ['@index' => $index_id], WATCHDOG_WARNING);
    return [];
  }

  $server = $index->server();
  $server_class = strtolower($server->class);

  // Warn early if query vector doesn't match index dimension.
  $expected_dimension = !empty($index->options['embedding_settings']['embeddings_engine_configuration']['dimension'])
    ? (int) $index->options['embedding_settings']['embeddings_engine_configuration']['dimension']
    : NULL;
  if ($expected_dimension && count($embedding) !== $expected_dimension) {
    watchdog('ai_related_content', 'Query embedding dimension mismatch for index @index. Expected @expected, got @actual.', [
      '@index' => $index_id,
      '@expected' => $expected_dimension,
      '@actual' => count($embedding),
    ], WATCHDOG_WARNING);
  }

  // Determine which vector client to use based on server class
  $matches = [];

  // Route to the appropriate backend search function
  if ($server_class === 'milvus') {
    // Fall back to the collection configured on the Search API server itself.
    if ($collection === '' && !empty($server->options['collection'])) {
      $collection = $server->options['collection'];
    }
    if ($collection === '') {
      watchdog('ai_related_content', 'No Milvus collection configured (module settings or server options); cannot perform vector search.', [], WATCHDOG_WARNING);
      return [];
    }
    $matches = ai_related_content_milvus_search($server, $collection, $embedding, $limit);
  }
  elseif ($server_class === 'pinecone') {
    $matches = ai_related_content_pinecone_search($server, $index, $embedding, $limit);
  }
  else {
    watchdog('ai_related_content', 'Unsupported server class: @class. Only Milvus and Pinecone are supported.', ['@class' => $server_class], WATCHDOG_WARNING);
    return [];
  }

  if (empty($matches)) {
    return [];
  }

  if (empty($matches) || !is_array($matches)) {
    return [];
  }

  $related = [];
  $seen = [];
  $stats = [
    'input_matches' => count($matches),
    'no_nid' => 0,
    'self' => 0,
    'duplicate' => 0,
    'excluded' => 0,
    'missing_or_unpublished' => 0,
    'no_access' => 0,
    'accepted' => 0,
  ];
  $sample_nids = [];

  foreach ($matches as $match) {
    $nid = $match['nid'] ?? NULL;
    $title = $match['title'] ?? '';
    if ($nid) {
      $sample_nids[] = $nid;
    }

    if (!$nid) {
      $stats['no_nid']++;
      continue;
    }

    // Skip if it's the current node
    if ((string)$nid === (string)$exclude_nid) {
      $stats['self']++;
      continue;
    }

    // Skip if we've already added this node
    if (isset($seen[$nid])) {
      $stats['duplicate']++;
      continue;
    }

    // Skip if this node is excluded (either per-node or URL-based)
    $excluded = ai_related_content_is_excluded($nid, TRUE);
    if (!empty($excluded['excluded'])) {
      $stats['excluded']++;
      continue;
    }

    $related_node = node_load($nid);
    if (!$related_node || empty($related_node->status)) {
      $stats['missing_or_unpublished']++;
      continue;
    }

    // Ensure the current user has view access to this node.
    if (!node_access('view', $related_node)) {
      $stats['no_access']++;
      continue;
    }
    $related[] = ['nid' => $nid, 'title' => $title];
    $seen[$nid] = TRUE;
    $stats['accepted']++;

    if (count($related) >= (int)$limit) {
      break;
    }
  }

  return $related;
}

/**
 * Determine if a node is excluded from appearing in related content.
 *
 * Checks both:
 * - Per-node exclusion flag (node edit form checkbox)
 * - URL-based exclusions (settings form)
 *
 * @param int $nid
 * @return bool
 */
function ai_related_content_is_excluded($nid, $details = FALSE) {
  $nid = (int) $nid;
  if (!$nid) {
    if ($details) {
      return ['excluded' => FALSE, 'methods' => []];
    }
    return FALSE;
  }

  $methods = [];

  // Check per-node exclusion flag (database)
  try {
    if (db_table_exists('ai_related_content_exclude')) {
      $result = db_query("SELECT 1 FROM {ai_related_content_exclude} WHERE nid = :nid", [':nid' => $nid])->fetchField();
      if ($result) {
        $methods[] = 'per-node checkbox';
      }
    }
  }
  catch (\Exception $e) {
    // Table may not exist yet; log and continue.
    watchdog('ai_related_content', 'Error checking exclusion for nid @nid: @error', [
      '@nid' => $nid,
      '@error' => $e->getMessage(),
    ], WATCHDOG_WARNING);
  }

  // Check URL-based exclusions from settings
  $config = config('ai_related_content.settings');
  $excluded_urls = $config->get('excluded_urls');

  if (!empty($excluded_urls)) {
    $node = node_load($nid);
    if ($node) {
      // Get the node's URL/path and alias
      $node_path = 'node/' . $nid;
      $node_alias = backdrop_get_path_alias($node_path);

      // Parse the excluded URLs (one per line)
      $excluded_list = array_filter(array_map('trim', explode("\n", $excluded_urls)));

      foreach ($excluded_list as $excluded) {
        // Normalize both paths for comparison (remove leading slash and trim)
        $excluded_normalized = ltrim(trim($excluded), '/');
        $alias_normalized = ltrim(trim($node_alias), '/');
        $path_normalized = ltrim(trim($node_path), '/');

        // Check if it matches the internal path (node/123)
        if ($excluded_normalized === $path_normalized) {
          $methods[] = 'URL-based exclusion';
          break;
        }

        // Check if it matches the alias (posts/my-post)
        if ($excluded_normalized === $alias_normalized) {
          $methods[] = 'URL-based exclusion';
          break;
        }
      }
    }
  }

  $excluded = !empty($methods);

  if ($details) {
    return ['excluded' => (bool) $excluded, 'methods' => $methods];
  }

  return (bool) $excluded;
}

/**
 * Set excluded flag for a node.
 *
 * @param int $nid
 * @param bool $excluded
 */
function ai_related_content_set_excluded($nid, $excluded) {
  $nid = (int) $nid;
  if (!$nid) return;
  if ($excluded) {
    db_merge('ai_related_content_exclude')
      ->key(['nid' => $nid])
      ->fields(['nid' => $nid])
      ->execute();
  }
  else {
    db_delete('ai_related_content_exclude')
      ->condition('nid', $nid)
      ->execute();
  }
}

/**
 * Implements hook_form_FORM_ID_alter(). Add exclude checkbox to node form.
 */
function ai_related_content_form_node_form_alter(&$form, &$form_state) {
  $node = isset($form_state['node']) ? $form_state['node'] : (object) [];
  $nid = !empty($node->nid) ? (int) $node->nid : 0;

  $form['ai_related_content'] = [
    '#type' => 'fieldset',
    '#title' => t('AI Related Content'),
    '#collapsible' => TRUE,
    '#collapsed' => TRUE,
    '#weight' => 100,
  ];

  $form['ai_related_content']['ai_related_content_exclude'] = [
    '#type' => 'checkbox',
    '#title' => t('Exclude this content from being recommended as related content'),
    '#default_value' => $nid ? (int) ai_related_content_is_excluded($nid) : 0,
    '#description' => t('If checked, this node can still be indexed/embedded, but it will not appear in related content suggestions.'),
  ];

  // Submit handler to persist the value.
  $form['#submit'][] = 'ai_related_content_node_form_submit';
}

/**
 * Submit handler for node form to save exclusion flag.
 */
function ai_related_content_node_form_submit($form, &$form_state) {
  $node = isset($form_state['node']) ? $form_state['node'] : NULL;
  if (!$node || empty($node->nid)) {
    // For new nodes, defer until it has a nid.
    return;
  }
  $exclude = !empty($form_state['values']['ai_related_content_exclude']);
  ai_related_content_set_excluded($node->nid, (bool) $exclude);
}

/**
 * Test form for diagnosing related content issues.
 */
function ai_related_content_test_form($form, &$form_state) {
  $form['#prefix'] = '<h2>' . t('AI Related Content Test') . '</h2>';

  // Show module status.
  $requirements = ai_related_content_runtime_requirements('runtime');
  $status_html = '<h3>' . t('Module Status') . '</h3><ul>';
  foreach ($requirements as $req) {
    $status = $req['severity'] === 0 ? '<span style="color: green;">OK</span>' : '<span style="color: orange;">Warning</span>';
    $status_html .= '<li><strong>' . $req['title'] . ':</strong> ' . $status . ' - ' . $req['description'] . '</li>';
  }
  $status_html .= '</ul>';

  // Show current configuration.
  $config = config('ai_related_content.settings');
  $index_id = $config->get('index_id');

  // Detect backend type.
  $backend_type = NULL;
  $backend_info = '';
  if ($index_id && function_exists('search_api_index_load')) {
    $index = search_api_index_load($index_id);
    if ($index && $index->server()) {
      $backend_type = strtolower($index->server()->class);
      $backend_info = '<li><strong>Backend Type:</strong> <span style="color: blue;">' . check_plain(ucfirst($backend_type)) . '</span></li>';
    }
  }

  $status_html .= '<h3>' . t('Current Configuration') . '</h3>';
  $status_html .= '<ul>';
  $status_html .= '<li><strong>Index ID:</strong> ' . check_plain($index_id) . '</li>';
  $status_html .= $backend_info;

  if ($backend_type === 'milvus') {
    $status_html .= '<li><strong>Collection Name (Milvus):</strong> ' . check_plain($config->get('collection_name')) . '</li>';
  } elseif ($backend_type === 'pinecone') {
    $status_html .= '<li><strong>Backend Notes:</strong> Pinecone uses namespaces (auto-configured from index)</li>';
    if ($index && $index->server()) {
      $namespace = ai_related_content_get_pinecone_namespace($index);
      $status_html .= '<li><strong>Namespace (Pinecone):</strong> ' . check_plain($namespace) . '</li>';
    }
  } else {
    $status_html .= '<li><strong>Collection Name:</strong> ' . check_plain($config->get('collection_name')) . '</li>';
  }

  $status_html .= '<li><strong>Limit:</strong> ' . check_plain($config->get('limit')) . ' (type: ' . gettype($config->get('limit')) . ')</li>';
  $status_html .= '<li><strong>Node View Mode (extraction):</strong> ' . check_plain($config->get('node_view_mode') ?: 'full') . '</li>';
  $status_html .= '<li><strong>View Display:</strong> ' . check_plain($config->get('view_display')) . '</li>';
  $status_html .= '</ul>';

  $form['status'] = [
    '#markup' => $status_html,
  ];

  $form['nid'] = [
    '#type' => 'textfield',
    '#title' => t('Node ID to Test'),
    '#description' => t('Enter a node ID to test related content lookup.'),
    '#default_value' => isset($form_state['values']['nid']) ? $form_state['values']['nid'] : '',
    '#size' => 10,
    '#required' => TRUE,
  ];

  $form['submit'] = [
    '#type' => 'submit',
    '#value' => t('Test Related Content'),
  ];

  // Show results if we have them.
  if (!empty($form_state['storage']['results'])) {
    $form['results'] = [
      '#markup' => $form_state['storage']['results'],
    ];
  }


  return $form;
}

/**
 * Submit handler for the test form.
 */
function ai_related_content_test_form_submit($form, &$form_state) {
  $nid = (int) $form_state['values']['nid'];
  $config = config('ai_related_content.settings');

  $test_node = node_load($nid);
  if (!$test_node) {
    backdrop_set_message(t('Node @nid not found.', ['@nid' => $nid]), 'error');
    $form_state['rebuild'] = TRUE;
    return;
  }

  $limit = (int) ($config->get('limit') ?: 3);

  // Use existing is_excluded($nid, TRUE) to get details.
  $exclusion_info = '';
  $excluded_details = ai_related_content_is_excluded($nid, TRUE);
  if (!empty($excluded_details['excluded'])) {
    $methods = !empty($excluded_details['methods']) ? $excluded_details['methods'] : [];
    $exclusion_info = '<div class="messages warning"><strong>' . t('Note: This node is excluded from related content') . '</strong> (' . implode(', ', $methods) . ')</div>';
  }

  $results_html = '<h3>' . t('Test Results for Node @nid: @title', ['@nid' => $nid, '@title' => $test_node->title]) . '</h3>';
  $results_html .= $exclusion_info;

  // Step 1: Show text extraction results.
  $results_html .= '<h4>' . t('Step 1: Text Extraction') . '</h4>';
  $text = ai_related_content_get_text($test_node);
  $text_preview = strlen($text) > 500 ? substr($text, 0, 500) . '...' : $text;
  $results_html .= '<p><strong>Text length:</strong> ' . strlen($text) . ' characters</p>';
  $results_html .= '<details><summary>Text preview (first 500 chars)</summary><pre style="white-space: pre-wrap; word-wrap: break-word; overflow-wrap: break-word; background: #f5f5f5; padding: 10px; max-height: 200px; overflow: auto;">' . check_plain($text_preview) . '</pre></details>';

  if (empty($text) || strlen($text) < 50) {
    $results_html .= '<p style="color: orange;"><strong>Warning:</strong> Very little text extracted. This may result in poor embeddings.</p>';
  }

  // Step 2: Show embedding results.
  $results_html .= '<h4>' . t('Step 2: Embedding Generation') . '</h4>';
  $embedding = ai_related_content_get_embedding($text, $config->get('index_id'));

  if (empty($embedding)) {
    $results_html .= '<p style="color: red;"><strong>✗ Failed:</strong> No embedding was generated. Check watchdog logs for errors.</p>';
  }
  elseif (!is_array($embedding)) {
    $results_html .= '<p style="color: red;"><strong>✗ Failed:</strong> Embedding is not an array. Type: ' . gettype($embedding) . '</p>';
  }
  else {
    $results_html .= '<p style="color: green;"><strong>✓ Success:</strong> Embedding generated with ' . count($embedding) . ' dimensions.</p>';
    $results_html .= '<details><summary>First 10 values</summary><pre>' . check_plain(json_encode(array_slice($embedding, 0, 10))) . '</pre></details>';
  }

  // Step 3: Show vector search results
  $results_html .= '<h4>' . t('Step 3: Vector Search') . '</h4>';
  $results_html .= '<p>' . t('Requesting @limit related items...', ['@limit' => $limit]) . '</p>';

  // Clear all match caches for this node first to ensure fresh results.
  cache_clear_all('ai_related_content_matches:' . $nid . ':', 'cache', TRUE);

  $related = ai_related_content_get_related_matches($test_node, $limit);

  if (empty($related)) {
    $results_html .= '<p><strong style="color: red;">' . t('✗ No related content found.') . '</strong></p>';
    $results_html .= '<p>' . t('Possible causes:') . '</p>';
    $results_html .= '<ul>';
    $results_html .= '<li>The vector database collection may be empty or not indexed</li>';
    $results_html .= '<li>The embedding dimensions may not match the indexed vectors</li>';
    $results_html .= '<li>The collection name may be incorrect</li>';
    $results_html .= '<li>Connection to Milvus/Pinecone may have failed</li>';
    $results_html .= '</ul>';
    $results_html .= '<p>' . t('Check the <a href="@url">watchdog logs</a> for detailed debug messages.', ['@url' => url('admin/reports/dblog', ['query' => ['type' => 'ai_related_content']])]) . '</p>';
  }
  else {
    $results_html .= '<p><strong style="color: green;">' . t('✓ Found @count related items:', ['@count' => count($related)]) . '</strong></p>';
    $results_html .= '<ol>';
    foreach ($related as $match) {
      $rel_node = node_load($match['nid']);
      $title = $rel_node ? $rel_node->title : $match['title'];
      $status_icon = ($rel_node && $rel_node->status) ? '✓' : '✗';
      $results_html .= '<li>' . $status_icon . ' ' . l($title, 'node/' . $match['nid']) . ' (nid: ' . $match['nid'] . ')';
      if (!$rel_node) {
        $results_html .= ' <span style="color: red;">[Node not found]</span>';
      }
      elseif (!$rel_node->status) {
        $results_html .= ' <span style="color: orange;">[Unpublished]</span>';
      }
      $results_html .= '</li>';
    }
    $results_html .= '</ol>';
  }

  $form_state['storage']['results'] = $results_html;
  $form_state['rebuild'] = TRUE;
}


/**
 * Helper: Invalidate related-content caches.
 *
 * If a specific $nid is provided, this will remove caches directly related
 * to that node (rendered block and matches). When a node is updated or
 * deleted, related recommendations site-wide may be affected; by default
 * we clear all ai_related_content caches to ensure correctness. If you
 * want a more targeted invalidation strategy, we can narrow this.
 *
 * @param int|null $nid
 *   Node id to target, or NULL to clear all related caches.
 */
function ai_related_content_invalidate_caches($nid = NULL) {
  // cache_clear_all() with $wildcard works on any cache backend, unlike a
  // direct db_delete() against the cache table.
  if ($nid) {
    // Remove caches for that source node, plus any other node's cached output
    // that could contain this node as a candidate (conservative but safe).
    cache_clear_all('ai_related_content_matches:' . (int) $nid . ':', 'cache', TRUE);
    cache_clear_all('ai_related_content:', 'cache', TRUE);
  }
  else {
    // Clear all module-related caches.
    cache_clear_all('ai_related_content:', 'cache', TRUE);
    cache_clear_all('ai_related_content_matches:', 'cache', TRUE);
  }

  watchdog('ai_related_content', 'Invalidated related-content caches for nid: @nid', ['@nid' => $nid ?: 'all'], WATCHDOG_NOTICE);
}


/**
 * Implements hook_node_insert(). Clear caches so new content can be
 * recommended by related-content searches.
 */
function ai_related_content_node_insert($node) {
  if (empty($node->nid)) return;
  // New content may appear in other nodes' recommendations; clear module caches.
  ai_related_content_invalidate_caches();
}


/**
 * Implements hook_node_update(). Clear caches so updated content is reflected
 * in related-content results.
 */
function ai_related_content_node_update($node) {
  if (empty($node->nid)) return;
  // Clear caches conservatively to ensure recommendations are refreshed.
  ai_related_content_invalidate_caches($node->nid);
}


/**
 * Implements hook_node_delete(). Clear caches and remove any per-node
 * exclusion records.
 */
function ai_related_content_node_delete($node) {
  if (empty($node->nid)) return;

  // Remove per-node exclusion entry if present.
  db_delete('ai_related_content_exclude')->condition('nid', (int) $node->nid)->execute();

  // Invalidate caches that may reference the deleted node.
  ai_related_content_invalidate_caches();
}
